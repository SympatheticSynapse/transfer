{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource that scrapes Jenkins",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Jenkins Agent Occupancy",
  "uid": "jenkins-agent-occupancy",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Agent state (one line per agent)",
      "description": "0 idle/offline, 1 running with executors free, 2 running with no free executors, 3 running with no free executors and builds queued (waiting).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{label}}",
          "expr": "(default_jenkins_executors_busy{label=~\"PATTERN_A|PATTERN_B|PATTERN_C\"} > bool 0)\n*\n(\n  1\n  + (default_jenkins_executors_available{label=~\"PATTERN_A|PATTERN_B|PATTERN_C\"} == bool 0)\n  + (\n      (default_jenkins_executors_available{label=~\"PATTERN_A|PATTERN_B|PATTERN_C\"} == bool 0)\n      * on() group_left()\n      (sum(default_jenkins_executors_queue_length) > bool 0)\n    )\n)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Idle",
                  "color": "#7a7a7a",
                  "index": 0
                },
                "1": {
                  "text": "Running",
                  "color": "blue",
                  "index": 1
                },
                "2": {
                  "text": "Full",
                  "color": "dark-blue",
                  "index": 2
                },
                "3": {
                  "text": "Waiting",
                  "color": "orange",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#7a7a7a",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              },
              {
                "color": "dark-blue",
                "value": 2
              },
              {
                "color": "orange",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Running jobs (one line per job)",
      "description": "Shown while a build of the job is running. If this shows a single series, check the real job label name in Explore and edit the legend.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{jenkins_job}}",
          "expr": "default_jenkins_builds_running_build_duration_milliseconds > bool 0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not running",
                  "color": "#7a7a7a",
                  "index": 0
                },
                "1": {
                  "text": "Running",
                  "color": "blue",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#7a7a7a",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pool utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "Pool A",
          "expr": "sum(default_jenkins_executors_busy{label=~\"PATTERN_A\"})\n/\nsum(default_jenkins_executors_online{label=~\"PATTERN_A\"})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "Pool B",
          "expr": "sum(default_jenkins_executors_busy{label=~\"PATTERN_B\"})\n/\nsum(default_jenkins_executors_online{label=~\"PATTERN_B\"})"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "Pool C",
          "expr": "sum(default_jenkins_executors_busy{label=~\"PATTERN_C\"})\n/\nsum(default_jenkins_executors_online{label=~\"PATTERN_C\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue length",
      "description": "Items that can run but are waiting on a free executor (controller-wide).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "interval": "30s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "Queue length",
          "expr": "sum(default_jenkins_executors_queue_length)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}
